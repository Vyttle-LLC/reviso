{
  // Prose is hard-wrapped by hand, not to a fixed column.
  "config": {
    "MD013": false,
    // Keep a Changelog repeats "### Added"/"### Changed" under every
    // version heading by design; only flag duplicates among siblings.
    "MD024": { "siblings_only": true },
    // The README centres its lockup and badges with inline HTML, which
    // Markdown has no equivalent for.
    "MD033": false,
    "MD041": false
  },
  "ignores": [
    "node_modules/**",
    // Contributor Covenant v2.1, vendored verbatim. Not ours to reformat.
    "CODE_OF_CONDUCT.md",
    // Upstream recipe snapshots, vendored verbatim as drift baselines
    // (eval/reference/README.md: "Do not edit the snapshot").
    "eval/reference/code-review-recipe-*.md",
    // Archived eval-run artifacts: machine-captured review output,
    // preserved verbatim — not prose to reformat.
    "eval/runs/**/*.md",
    // Gitignored clone cache for eval checkouts: third-party repos'
    // own markdown. CI never sees it; keep local runs quiet too.
    "eval/.cache/**"
  ]
}
